PROJECT_NAME=SiHijau API
API_V1_STR=/api/v1
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=sihijau_user
POSTGRES_PASSWORD=sihijau_password
POSTGRES_DB=sihijau_db
